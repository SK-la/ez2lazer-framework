<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>
  <PropertyGroup>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\osu.Framework\osu.Framework.csproj" />
  </ItemGroup>
  <ItemGroup Label="Package References">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>
  <!-- ProjectReference does not pull Framework AfterTargets copies; place plutosvgft next to the test host. -->
  <Target Name="CopyPlutoSvgFtNativesForTests" AfterTargets="Build">
    <ItemGroup>
      <_PlutoSvgFtNative Include="$(MSBuildThisFileDirectory)..\osu.Framework\runtimes\**\native\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PlutoSvgFtNative)"
          DestinationFiles="@(_PlutoSvgFtNative->'$(OutputPath)runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_PlutoSvgFtNative)' != ''" />
  </Target>
</Project>
